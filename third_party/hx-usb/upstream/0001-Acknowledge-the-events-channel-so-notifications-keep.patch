--- a/PROTOCOL.md
+++ b/PROTOCOL.md
@@ -127,6 +127,20 @@ received bytes while nobody was waiting on it, moved this from failing on the
 third preset-document write to comfortably past ten. Measured on an HX Stomp
 running 3.80.
 
+**The events channel needs ACK frames, not keep-alives. [confirmed]** The device
+sends at most 4 KB of notifications that have not been acknowledged by an ACK frame
+(type 0x08), then stops sending on channel `0x1002` and stays silent, across new
+sessions, until its power is pulled. A keep-alive carries the same acknowledgement
+in its header, but the device does not count it. HX Edit sends an ACK for almost
+every notification: in `captures/mac-library-capture.log` the device sends 3453 data
+frames (72 KB) on the events channel and HX Edit answers with 3334 ACKs, each within
+about 50 ms, `ack = 0x1000 + bytes received`. `poll_notifications` now does the same
+whenever the channel is owed bytes, and `keepalive` no longer marks the channel
+acknowledged. Measured on an HX Effects at 3.80, after a power cycle, pedal
+untouched, three minutes of `watch`: 195 notifications and then silence before
+(195 ticks of 21 bytes is 4095 bytes), 1095 and still flowing after. The device
+tests do not cover this; `fake::Pedal::events_window` models it.
+
 Two things that look like fixes and are not:
 
 - **Acknowledging the channel a reply just arrived on, before returning.** The
diff --git a/crates/hx-usb/src/commands.rs b/crates/hx-usb/src/commands.rs
index 9f49c08..1f18628 100644
--- a/crates/hx-usb/src/commands.rs
+++ b/crates/hx-usb/src/commands.rs
@@ -1263,8 +1263,24 @@ impl Session {
     }
 
     /// Any notifications the device has pushed since the last call.
+    ///
+    /// Acknowledges the events channel with an ACK frame whenever it has
+    /// unacknowledged bytes, as HX Edit does after almost every notification.
+    /// The device sends at most 4 KB of notifications unacknowledged and does
+    /// not count a keep-alive's acknowledgement; without this an HX Effects
+    /// went silent after 195 notifications until power-cycled (PROTOCOL.md,
+    /// "The events channel needs ACK frames"). No host transaction ever runs on
+    /// the events channel, so
+    /// this cannot land mid-transaction.
     pub fn poll_notifications(&mut self) -> Result<Vec<(i64, Value)>> {
         self.read_available(Duration::from_millis(20))?;
+        let behind = self
+            .channels
+            .get(&ChannelId::EVENTS.device)
+            .is_some_and(|c| c.rx_bytes != c.acked);
+        if behind {
+            self.ack_channel(ChannelId::EVENTS)?;
+        }
         let mut out = Vec::new();
         for ch in self.channels.values_mut() {
             for sm in ch
@@ -1651,6 +1667,44 @@ mod pedal_tests {
     use super::*;
     use crate::fake::{self, Pedal};
 
+    /// The pedal's tick, `{82: 0, 68: 10, 121: 27, 106: nil}`: 21 bytes on
+    /// the events channel, about six a second on an idle HX Effects.
+    fn tick() -> Value {
+        hx_proto::msgmap! {
+            82 => Value::Int(0),
+            68 => Value::Int(10),
+            121 => Value::Int(27),
+            106 => Value::Nil,
+        }
+    }
+
+    /// `tonepush watch`'s loop, against a pedal that stops sending once 4 KB
+    /// of notifications go unacknowledged: every notification must arrive.
+    /// Without an ACK on the events channel this stopped at 195, as the HX
+    /// Effects did (PROTOCOL.md, "The events channel needs ACK frames").
+    #[test]
+    fn watching_keeps_the_events_channel_flowing() {
+        let pedal = Pedal::new();
+        let mut session = fake::session(&pedal);
+        // Whatever the handshake left behind.
+        session.poll_notifications().unwrap();
+        pedal.lock().unwrap().events_window = Some(4096);
+        let mut seen = 0;
+        for round in 0..100 {
+            {
+                let mut pedal = pedal.lock().unwrap();
+                for _ in 0..6 {
+                    pedal.notify(22, tick());
+                }
+            }
+            for _ in 0..8 {
+                seen += session.poll_notifications().unwrap().len();
+            }
+            session.keepalive().unwrap();
+            assert_eq!(seen, 6 * (round + 1), "stalled after {seen} notifications");
+        }
+    }
+
     const SAMPLES: [f32; 4] = [0.5, -0.25, 0.125, 0.0];
 
     fn sum_of(samples: &[f32]) -> u64 {
