From 25a4bb157ff81a73421dfb88fd640d87a230045f Mon Sep 17 00:00:00 2001
From: anthonybartczak <49080651+anthonybartczak@users.noreply.github.com>
Date: Wed, 11 Nov 2026 20:43:46 +0100
Subject: [PATCH 5/6] Keep a notification split across the events service
 opening

The device splits a notification across two frames after its first
four bytes. `open_service` cleared the realigner after reading the
reply to the service opening, so a first half that arrived with that
reply was dropped and the notification was lost when its body came.

Only the clear after the handshake stays: what the channel sent before
it was for the session before, and the stream starts again on a fresh
header. The fake pedal can now say something the moment the events
service opens, for the test.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 crates/hx-usb/src/commands.rs | 17 +++++++++++++++++
 crates/hx-usb/src/fake.rs     |  9 +++++++++
 crates/hx-usb/src/lib.rs      |  4 +++-
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/crates/hx-usb/src/commands.rs b/crates/hx-usb/src/commands.rs
index 22bfa91..777d508 100644
--- a/crates/hx-usb/src/commands.rs
+++ b/crates/hx-usb/src/commands.rs
@@ -1906,6 +1906,23 @@ mod pedal_tests {
         assert_eq!(session.events_skipped(), 0);
     }
 
+    /// The device splits a notification across two frames after its first
+    /// four bytes. When the first of them arrives while the events service
+    /// is still being opened, the notification is kept all the same.
+    #[test]
+    fn a_notification_split_across_the_service_opening_is_kept() {
+        let pedal = Pedal::new();
+        pedal.lock().unwrap().events_at_open = Some(TICK_BYTES[..4].to_vec());
+        let mut session = fake::session_as(&pedal, hx_proto::HX_EFFECTS);
+        pedal.lock().unwrap().send_raw_events(&TICK_BYTES[4..]);
+        let mut seen = 0;
+        for _ in 0..2 {
+            seen += session.poll_notifications().unwrap().len();
+        }
+        assert_eq!(seen, 1);
+        assert_eq!(session.events_skipped(), 0);
+    }
+
     #[test]
     fn a_session_says_whether_the_events_channel_answered() {
         let pedal = Pedal::new();
diff --git a/crates/hx-usb/src/fake.rs b/crates/hx-usb/src/fake.rs
index 08b3003..684a3de 100644
--- a/crates/hx-usb/src/fake.rs
+++ b/crates/hx-usb/src/fake.rs
@@ -71,6 +71,9 @@ pub struct Pedal {
     events_acked: u32,
     /// Notifications waiting for the window to open.
     events_held: VecDeque<Vec<u8>>,
+    /// Stream bytes to send on the events channel, as they are, the moment
+    /// its service is opened: what the device has to say first.
+    pub events_at_open: Option<Vec<u8>>,
     inbox: BTreeMap<u16, StreamReader>,
     seq: BTreeMap<u16, u16>,
 }
@@ -97,6 +100,7 @@ impl Pedal {
             events_sent: 0,
             events_acked: 0,
             events_held: VecDeque::new(),
+            events_at_open: None,
             inbox: BTreeMap::new(),
             seq: BTreeMap::new(),
         }))
@@ -179,6 +183,11 @@ impl Pedal {
             self.failing_reads = Some(why);
         }
         let node = frame.dst;
+        if node == ChannelId::EVENTS.device {
+            if let Some(bytes) = self.events_at_open.take() {
+                self.send_raw_events(&bytes);
+            }
+        }
         let reader = self.inbox.entry(node).or_default();
         reader.push(rest);
         let messages = reader.take_messages().unwrap_or_default();
diff --git a/crates/hx-usb/src/lib.rs b/crates/hx-usb/src/lib.rs
index 5917e3e..9b11e69 100644
--- a/crates/hx-usb/src/lib.rs
+++ b/crates/hx-usb/src/lib.rs
@@ -547,6 +547,9 @@ impl Session {
             ch.reader
                 .take_messages()
                 .map_err(|error| Error::Protocol(error.to_string()))?;
+            // Whatever the events channel sent before its handshake was
+            // for the session before, and a message cut short there is
+            // never finished: the stream starts again on a fresh header.
             ch.realign.clear();
             ch.rx_bytes = carried;
             // HX Edit's counter jumps 0 -> 2 here. The device stops responding
@@ -560,7 +563,6 @@ impl Session {
             ch.reader
                 .take_messages()
                 .map_err(|error| Error::Protocol(error.to_string()))?;
-            ch.realign.clear();
         }
         self.ack_channel(id)
     }
