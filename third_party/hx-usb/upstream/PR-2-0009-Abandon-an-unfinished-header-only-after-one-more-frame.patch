+        let garbage = [0x00, 0x00, 0x04, 0x00, 0x00, 0x10, 0x00, 0x00];
+        let mut realign = Realign::default();
+        assert!(realign
+            .push(&[&garbage[..], &ticks(2)[..]].concat())
