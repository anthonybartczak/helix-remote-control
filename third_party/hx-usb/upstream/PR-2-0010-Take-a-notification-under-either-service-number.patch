From 7ab9b7e007d313c9f91f3fba3866c94db0b9dbdf Mon Sep 17 00:00:00 2001
From: anthonybartczak <49080651+anthonybartczak@users.noreply.github.com>
Date: Thu, 12 Nov 2026 21:59:36 +0100
Subject: [PATCH] Take a notification under either service number

Since 739fad9 the realigner took a notification for one only when its
header named service 4. The pretend pedal writes 0 there, so an HX
Effects session heard nothing it said, and no test noticed: the tests
that go through the realigner send raw captured bytes.

The header's service number is no longer held against a notification.
In the captures it is always 4 there, but the stream reader trusts only
a header's length, because on some replies the device leaves that field
uninitialised. The body still has to be exactly one notification.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 crates/hx-usb/src/commands.rs | 17 +++++++++++++++++
 crates/hx-usb/src/realign.rs  | 25 ++++++++++++++++++++-----
 2 files changed, 37 insertions(+), 5 deletions(-)

diff --git a/crates/hx-usb/src/commands.rs b/crates/hx-usb/src/commands.rs
index 777d508..1c9b7cc 100644
--- a/crates/hx-usb/src/commands.rs
+++ b/crates/hx-usb/src/commands.rs
@@ -1860,6 +1860,23 @@ mod pedal_tests {
         }
     }
 
+    /// An HX Effects session, whose events channel goes through the
+    /// realigner, still hears what the pretend pedal says. The pretend pedal
+    /// writes 0 where the device writes the service number.
+    #[test]
+    fn an_hx_effects_session_hears_the_pedal() {
+        let pedal = Pedal::new();
+        let mut session = fake::session_as(&pedal, hx_proto::HX_EFFECTS);
+        session.poll_notifications().unwrap();
+        pedal.lock().unwrap().notify(22, tick());
+        let mut seen = 0;
+        for _ in 0..2 {
+            seen += session.poll_notifications().unwrap().len();
+        }
+        assert_eq!(seen, 1);
+        assert_eq!(session.events_skipped(), 0);
+    }
+
     /// The tick as the HX Effects sends it, stream header included.
     const TICK_BYTES: [u8; 21] = [
         0x00, 0x00, 0x04, 0x00, 0x0d, 0x00, 0x00, 0x00, 0x82, 0x69, 0x16, 0x6a, 0x84, 0x52, 0x00,
diff --git a/crates/hx-usb/src/realign.rs b/crates/hx-usb/src/realign.rs
index ab34d90..4eba966 100644
--- a/crates/hx-usb/src/realign.rs
+++ b/crates/hx-usb/src/realign.rs
@@ -68,7 +68,12 @@ enum At {
 /// Effects 3.80, Pi 4, 2026-10-15, after front-panel knob turns). And a
 /// header in front of a real notification, over a body that merely begins
 /// with a value that decodes, would take that notification with it.
-fn whole(service: u16, body: &[u8], end: usize) -> At {
+///
+/// The service number in the header is not held against a notification. In
+/// the captures it is always 4 there, but the stream reader trusts only the
+/// length of a header, and with reason: on some replies the device leaves
+/// the field uninitialised.
+fn whole(body: &[u8], end: usize) -> At {
     let mut decoder = hx_proto::msgpack::Decoder::new(body);
     let Ok(value) = decoder.value() else {
         return At::Not;
@@ -80,9 +85,7 @@ fn whole(service: u16, body: &[u8], end: usize) -> At {
         return At::Opened(end);
     }
     match hx_proto::rpc::Message::try_from_value(value) {
-        Ok(hx_proto::rpc::Message::Notification { .. }) if service == EVENTS_SERVICE => {
-            At::Notification(end)
-        }
+        Ok(hx_proto::rpc::Message::Notification { .. }) => At::Notification(end),
         _ => At::Not,
     }
 }
@@ -156,7 +159,7 @@ impl Realign {
         if self.buf.len() < end {
             At::Waiting
         } else {
-            whole(service, &self.buf[pos + 8..end], end)
+            whole(&self.buf[pos + 8..end], end)
         }
     }
 
@@ -384,6 +387,18 @@ mod tests {
         assert_eq!(realign.skipped(), 0);
     }
 
+    #[test]
+    fn a_notification_passes_under_either_service_number() {
+        // The header's service field is not held against a notification:
+        // the stream reader trusts only the length, and the pretend pedal
+        // writes 0 there.
+        let mut under_zero = TICK.to_vec();
+        under_zero[2] = 0;
+        let mut realign = Realign::default();
+        assert_eq!(realign.push(&under_zero), under_zero);
+        assert_eq!(realign.skipped(), 0);
+    }
+
     #[test]
     fn a_body_read_as_a_huge_length_is_stepped_over() {
         let mut realign = Realign::default();
-- 
