# Helix Bridge settings. Installed once to /etc/helix-bridge/helix-bridge.env;
# install.sh never overwrites your edits. Apply changes with:
#   sudo systemctl restart helix-bridge
# All variables: README.md, "Running the server".

# cli = real device via tonepush; fake = replay the bundled fixtures (no device needed).
HELIX_BACKEND=cli
# Port 80 so the iPad opens http://helix-bridge.local. If you change the port,
# also change it in /etc/avahi/services/helix-bridge.service.
HELIX_BIND=0.0.0.0:80
HELIX_TONEPUSH=/opt/helix-bridge/bin/tonepush
HELIX_TONEPUSH_TIMEOUT_SECS=30
HELIX_FIXTURES=/opt/helix-bridge/fixtures

# HX Edit's "res" folder, copied from the dev machine (never committed, AGENTS.md 5.4).
# Without it tonepush still works but shows no model or parameter names.
HX_EDIT_RESOURCES=/opt/helix-bridge/vendor/res

# Shared token for write operations (load preset, edit, rename, save). Unset or
# empty = read-only. Make one with: openssl rand -hex 16
# The iPad asks for it on the first write and keeps it in Safari.
# Never commit a real token (AGENTS.md 6).
#HELIX_TOKEN=

RUST_LOG=info
